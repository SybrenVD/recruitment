@page "/candidates"
@inject ICandidateApiClient CandidateApiClient

<PageTitle>Candidates</PageTitle>

<h1>Candidates</h1>

@if (candidates == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Email</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in candidates)
            {
                <tr>
                    <td>@c.Id</td>
                    <td>@c.FirstName @c.LastName</td>
                    <td>@c.Email</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IEnumerable<Recruitment.Entities.Candidate>? candidates;

    protected override async Task OnInitializedAsync()
    {
        candidates = await CandidateApiClient.GetAllAsync();
    }
}
